# .env.example — commit this file, NEVER the real .env
# Copy to .env and fill in real values before running docker compose.

# Nextcloud trusted domains (space-separated list)
TRUSTED_DOMAINS=localhost 127.0.0.1

# Nextcloud admin credentials
ADMIN_USER=admin
ADMIN_PASSWORD=changeme

# MariaDB passwords
DB_PASSWORD=changeme
DB_ROOT_PASSWORD=changeme

# Slack incoming-webhook URL for anomaly alerts
SLACK_WEBHOOK=https://hooks.slack.com/services/CHANGE/THIS/VALUE

# Dry-run mode: "true" = log only, "false" = actually block IPs
DRY_RUN=true
